#!/usr/bin/env bash

set -e

extension_name="solidus_stripe"
app_name="dummy-app"

bin/rails-new "$app_name"

# Stay away from the bundler env of the containing extension.
function unbundled {
  echo "~~> Running: $@"
  ruby -rbundler -e'Bundler.with_unbundled_env { exec(*ARGV) }' -- env BUNDLE_SUPPRESS_INSTALL_USING_MESSAGES=true "$@"
}

cd ./dummy-app

# Coverage
echo "require_relative '../../coverage.rb' if ENV['COVERAGE']" >> config/boot.rb
echo "gem 'rspec_junit_formatter', require: false" >> Gemfile
echo "gem 'stripe-ruby-mock', group: :test" >> Gemfile
echo "gem 'vcr', group: :test" >> Gemfile
echo "gem 'webmock', group: :test" >> Gemfile
unbundled bundle install

unbundled bundle add $extension_name --path ..
unbundled bundle exec rails generate $extension_name:install --migrate --load-seeds=false --specs=all

# Keep the storefront's own product specs. Limit the no-price lookup to the
# named product so unrelated records cannot push it off the first page.
ruby -i -pe 'if /it .lists products without a price./ .. /^  end/; sub(/visit products_path$/, %q{stub_spree_preferences(products_per_page: 1)
    visit products_path(keywords: "Solidus hoodie")}); end' spec/system/products_spec.rb

if [[ -f spec/solidus_starter_frontend_spec_helper.rb ]]; then
  # The legacy spec injects a gateway exception via the old updater method.
  # Core 4.7 calls recalculate_payment_state at the same checkout transition.
  ruby -i -pe 'sub(/receive\(:update_payment_state\)\.and_raise/, "receive(:recalculate_payment_state).and_raise")' spec/requests/checkouts_spec.rb
fi
